{
  "permissions": {
    "deny": [
      "WebFetch(domain:elixir.bootlin.com)",
      "WebFetch(domain:kernel.org)",
      "WebFetch(domain:*.kernel.org)",
      "WebFetch(domain:sourceware.org)",
      "WebFetch(domain:git.savannah.gnu.org)",
      "WebFetch(domain:git.qemu.org)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|NotebookEdit|WebFetch|web_search|web_fetch|open_page|open_page_with_find",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/license-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/beads-actor.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/tools/round-status.py",
    "refreshInterval": 1
  }
}
